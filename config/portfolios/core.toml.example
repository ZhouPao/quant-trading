# 复制为 core.toml 后使用（真实 toml 不入 git）
# 组合 = 若干「策略 × 品种」单元；PRD §4.6.1
# 8-1 只加载与分配，尚未接线到引擎/worker；启用 [portfolio] enabled 前请看 PROGRESS 8.108。
portfolio_id = "core"
name = "核心双单元组合"
allocator = "equal"          # equal | fixed | inverse_vol | vol_target（单一组合只用一种）
max_unit_weight = "0.60"     # 单单元权重上限；比例用字符串避免 TOML float 精度损失
target_vol = "0.20"          # vol_target 法的年化目标波动
vol_window_bars = 30         # 波动率估算窗口（8-2 接 BarStorage）

[rebalance]
mode = "calendar"            # calendar | threshold | both（8-3 再平衡使用）
interval_hours = 24
drift_pct = "0.05"
cooldown_hours = 6

[risk]
max_drawdown_pct = "0.15"
max_correlation = "0.80"
max_unit_contribution_pct = "0.50"

[[units]]
strategy_id = "sma_cross"
inst_id = "BTC-USDT"
params_ref = "sma_cross"     # 指向 config/strategies/sma_cross.toml
weight = "0.60"              # fixed 法必填；其它分配法可留空
enabled = true

[[units]]
strategy_id = "rsi"
inst_id = "ETH-USDT"         # 本地需先有该品种 K 线（quant sync-candles --inst ETH-USDT）
params_ref = "rsi"
weight = "0.40"
enabled = false              # 停用：保留配置/持仓/历史，仅停止新信号（M6-2）
