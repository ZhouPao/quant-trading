# 复制为 config.toml 并填入真实值；config.toml 不入 git（见 .gitignore）
# 配置加载语法：${ENV_VAR} 引用环境变量；${ENV_VAR:-default} 提供默认值

[okx]
api_key = "${OKX_API_KEY}"
secret = "${OKX_SECRET}"
passphrase = "${OKX_PASSPHRASE}"
demo = true                         # true=模拟盘，false=实盘；M1 可保持 true
# 全局口径：行情/K线/ticker/OI 也会跟随 demo（模拟盘是独立虚拟市场）。
# 本机需代理才能连 OKX WS 时填 http://host:port；不填=直连。
# ws_proxy = "http://127.0.0.1:7897"

[storage]
data_dir = "./data"
retention_days = 365                # K线/SQLite 历史/日报 CSV 的保留天数
# 按周期覆盖保留天数（M10-3）：短周期数据量大、价值衰减快；
# 未列出的周期沿用 retention_days。示例：retention_by_bar = { "1m" = 30, "5m" = 90 }
retention_by_bar = {}
retention_enabled = true            # monitor 每日自动清理；false 时只能 quant prune
retention_at = "03:30"              # 本地时间 HH:MM
dead_letter_persist = true            # 死信双写 SQLite，供看板查看与重放

[factors]
# M5-13：默认关闭；开启后回测/实盘会把因子值填进 Context.factors。
# 关闭时行为与接入前逐点一致（有回归测试保证）。
enabled = false
ids = []                             # 例如 ["momentum_20", "volatility_20"]

[rate_limit]
timeout_seconds = 10.0

[logging]
level = "INFO"                      # DEBUG/INFO/WARNING/ERROR
file = "./logs/quant-trading.log"
rotation = "10 MB"
retention = "30 days"

# 以下段落 M1 不实现，M2 起由下游模块扩展；此处仅预留形状
[redis]
url = "${REDIS_URL:-redis://localhost:6379/0}"
queue_key = "quant:signals"              # LIST 主队列
inflight_key = "quant:signals:inflight"  # 处理中暂存（崩溃可恢复）
dead_key = "quant:signals:dead"          # 死信队列
dedup_prefix = "quant:dedup:"            # SET 键前缀 + hash(signal_json)
dedup_ttl_seconds = 300                  # 5 分钟（TV 网络异常重发保护）

[webhook]
host = "127.0.0.1"
port = 8000
path = "/webhook/tv"
# TV alert 不能自定义请求头，token 可放在 URL(?token=)或 JSON 体 "token" 字段；
# 也能用 X-Auth-Token 头（自建调用方）。对外监听时至少配一项，否则拒绝启动。
auth_token = "${WEBHOOK_AUTH_TOKEN:-}"    # 空=不校验（仅限 127.0.0.1）
hmac_secret = "${WEBHOOK_HMAC_SECRET:-}"  # X-Signature = hex(HMAC-SHA256(body))
ack_timeout_seconds = 5

[backtest]
initial_cash = "10000"                    # 回测初始资金（USDT）
commission_rate = "0.001"                 # 双边手续费率
slippage_bps = "5"                        # 滑点（基点）
window_size = 200                         # 策略可见历史 bar 数
task_workers = 1                          # 回测任务消费者数（CPU 密集，默认串行）
artifacts_dir = "./data/backtests"        # 回测产物目录（equity/trades/report）
max_combos = 500                          # 单次寻优的组合上限（CLI 与看板共用）
funding_rate_enabled = false              # 计入永续资金费率成本（需先 fetch-funding-rates 回补 -SWAP）

[params]
resolve_from_db = true                    # 策略参数是否合并在线覆盖；false=只看 toml（回滚开关）

# 组合管理（M6）：默认关闭，关闭时系统行为与单策略单品种完全一致。
# 启用前复制 config/portfolios/core.toml.example 为 core.toml 并按需改单元。
[portfolio]
enabled = false
config_dir = "./config/portfolios"
active = ""                              # 空=加载目录下全部组合；多组合时填 portfolio_id
snapshot_every_bars = 1                  # 快照频率：每 N 根 bar 收盘写一次（M6-10）

[state]
db_path = "./data/state/quant.db"         # SQLite 状态库

# 全局风控默认值：与策略 toml 的 [risk] 取严（取更小的一方）。
# 留空（默认）表示不参与取严，由代码默认兜底；填入即对所有策略生效。
# 在线覆盖（页面调整）直接覆盖这里，不参与取严。
[risk]
# max_position_pct = 0.3
# max_total_pct = 0.8
# max_order_qty = 10000
# daily_loss_limit = 0.05
# consecutive_loss_limit = 3
allow_initial_equity_fallback = false     # 权益快照缺失时是否退回 initial_cash 下单（false=拒单）
snapshot_max_age_ms = 180000              # 快照最大可接受年龄，超龄视为不可用
event_log = true                          # 拒绝/减量/硬停止是否写入 risk_events
circuit_enabled = true                    # 极端行情熔断（单品种暂停，与 kill switch 分离）
circuit_amplitude_pct = 0.10              # 单根振幅 (high-low)/open 超过即熔断
circuit_cooldown_seconds = 900            # 熔断冷却时长（秒），到期自动解除
circuit_resume_requires_confirm = true    # 冷却结束需人工确认才恢复；true 时键永久保留，长期不确认该品种会一直不开仓（false=到期自动恢复）
preflight_enabled = true                  # 下单前预检（仅直连 OKX 时生效）：产品配置/lotSz/minSz/最小名义金额/现货余额
preflight_min_notional_usdt = "0"         # 最小名义金额下限（USDT）；0=只按交易所 minSz，不额外加码
preflight_balance_buffer_pct = "0.02"     # 现货买入需预留 2% 余量（覆盖手续费与价格波动）
preflight_balance_cache_seconds = 15      # 余额快照缓存秒数；同一轮批量下单只查一次

[execution]
reconcile_interval_seconds = 60           # worker 运行期对账间隔（0=仅启动时对账）
order_timeout_seconds = 300               # 挂单超时自动撤单（秒，0=关闭）
server_side_sizing = true                 # 服务端仓位计算：信号可省略 qty，按权益比例补量（false=回到 qty 必填）
default_size_pct = "0.1"                  # 信号既没给 qty 也没给 size_pct 时的单笔目标占比

[candles]
insts = ["BTC-USDT"]                      # 定时增量同步的品种
bar = "1H"                                # 单周期回退值（bars 为空时生效）
# 多周期增量同步（M2-12）：与看板 9 档周期切换保持一致；只需部分周期可删减。
# 本地没有某周期的 parquet 时，看板仍显示该按钮并标注「暂无数据」。
bars = ["1m", "5m", "15m", "30m", "1H", "4H", "6H", "12H", "1D"]
# 新周期首次同步补的历史根数；0=只拉 lookback_bars（会只剩几根 K 线）
first_sync_bars = 300
interval_seconds = 300                    # 轮询间隔；0=只跑一次
lookback_bars = 3                         # 每次回看几根，顺带补断点附近的洞

[quality]
enabled = true                            # candles 每轮校验后写 data/quality/**/latest.json
window_bars = 5000                        # 每轮校验回看多少根已收盘 K 线
alert_cooldown_seconds = 3600             # 未修复缺口告警冷却，按 (inst, bar) 分别计时

[engine]
enabled = true                            # 本地策略实时信号引擎（不依赖 TradingView）
strategy = "sma_cross"                    # 与 config/strategies/{id}.toml 对应
inst = "BTC-USDT"
bar = "1H"
interval_seconds = 60                     # 轮询间隔；每根 bar 只评估一次
warmup_bars = 200                         # 回放窗口，需覆盖策略最慢周期
config_dir = "./config/strategies"
cash_fallback = "10000"                   # 读不到账户可用 USDT 时的兜底仓位基数
multi_binding = true                      # false=回滚开关，只跑下面 strategy/inst/bar 一个组合
bindings_fail_mode = "db"                 # 绑定缓存丢失时：db=回落读 SQLite / halt=停止新开仓

[dashboard]
host = "127.0.0.1"                        # 只读看板监听地址，默认仅本机
port = 8080
web_dir = "./web/dist"                    # 前端构建产物目录
token = "${DASHBOARD_TOKEN:-}"            # 写操作 token；留空=只校验本机 Host + 自定义头

[monitor]
alerts_persist = true                     # 告警写 SQLite；false 退回「只写 Redis」的旧行为
disabled_rules = []                       # 规则级启停（M9-2），如 ["api_error_rate"]；静音用于临时压噪，这里是长期停用
alert_retention_error_days = 90           # 告警保留分档（M9-12）：0 表示该级别不自动清理
alert_retention_warning_days = 30
alert_retention_info_days = 7
risk_limits_key = "quant:risk:limits"     # worker 发布生效阈值（键后缀 :{strategy}），看板只读
risk_overrides_key = "quant:risk:overrides" # 在线阈值覆盖 hash（{strategy}:{param}）；清空即全部回落配置

[report]
enabled = false                           # true=monitor 每日定时出模拟盘偏离日报
at = "08:00"                              # 本地时间 HH:MM（monitor 在该时刻后的第一轮生成）
strategy = "sma_cross"
inst = "BTC-USDT"
bar = "1H"
window_hours = 24
threshold = 0.05                          # 最大允许偏离（超过记 FAIL）
limit = 500                               # 读取的模拟盘成交上限
config_dir = "./config/strategies"
out_dir = "./reports/daily"               # CSV 输出目录
email = true                              # SMTP 未配置时自动降级为仅日志

[smtp]
# 告警与日报邮件；host/username/to_addrs 缺任一则降级为仅日志。
# 密码为邮箱「授权码」，不是登录密码；详见 docs/reference/SMTP_SETUP.md
host = "${SMTP_HOST:-smtp.qq.com}"        # QQ 邮箱 smtp.qq.com；其他服务商按需改
port = 465
username = "${SMTP_USERNAME:-}"           # 发件邮箱地址
password = "${SMTP_PASSWORD:-}"           # 邮箱授权码（非登录密码）
from_addr = "${SMTP_FROM:-}"              # 留空则用 username
to_addrs = []                             # 收件人列表，如 ["me@example.com"]
use_ssl = true
