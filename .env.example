# 复制为 .env 后填入真实值；.env 不入 git（见 .gitignore）
# config/config.toml 通过 ${VAR} / ${VAR:-default} 引用这里的值

# --- OKX 凭证（必填；模拟盘也要填）---
# 模拟盘 Key 在 OKX「模拟交易」页面申请，与实盘 Key 不通用
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# --- Redis（可选；默认 redis://localhost:6379/0）---
# REDIS_URL=redis://localhost:6379/0

# --- Webhook 鉴权（可选；公网监听时必须至少配一项）---
# TradingView 不能自定义请求头，token 可放 URL ?token= 或 alert 正文 token 字段
# WEBHOOK_AUTH_TOKEN=
# WEBHOOK_HMAC_SECRET=

# --- 看板写操作 token（可选；留空则只校验本机 Host + X-Dashboard-Request）---
# DASHBOARD_TOKEN=

# --- 邮件告警（可选；不配则降级为仅日志）---
# 详见 docs/reference/SMTP_SETUP.md；password 是邮箱「授权码」，不是登录密码
# SMTP_HOST=smtp.qq.com
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=
# SMTP_FROM=you@example.com
